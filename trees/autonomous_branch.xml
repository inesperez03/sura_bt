<root>
  <BehaviorTree ID="AutonomousBranch">
    <MissionControl name="mission_control">
      <VariableSet name="mission_running" key="mission_state" value="running"/>
      <Sequence name="autonomous_mission_sequence">
        <SurfaceAction name="surface_action" robot_namespace="bluerov"/>
      </Sequence>
      <VariableSet name="set_mission_completed" key="mission_state" value="completed"/>
      <MissionCompleted name="mission_completed"/>
    </MissionControl>
  </BehaviorTree>
</root>
