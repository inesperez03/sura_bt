<root main_tree_to_execute="Mission">

  <BehaviorTree ID="Mission">
    <ReactiveSequence name="root">
      <SubTree ID="SafetyBranch" name="safety" __shared_blackboard="true"/>
      <ReactiveFallback name="mission">
        <ReactiveSequence name="teleop_mode">
          <TeleopRequested name="teleop_requested"/>
          <SubTree ID="TeleopBranch" __shared_blackboard="true"/>
        </ReactiveSequence>

        <ReactiveSequence name="autonomous_mode">
          <AutonomousRequested name="autonomous_requested"/>
          <SubTree ID="AutonomousBranch" __shared_blackboard="true"/>
        </ReactiveSequence>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>

</root>
